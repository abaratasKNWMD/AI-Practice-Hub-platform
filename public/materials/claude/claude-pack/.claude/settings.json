{
  "permissions": {
    "defaultMode": "plan"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/scripts/block-secrets.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/scripts/require-tests.js"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "printf 'Claude team pack | use /context and /usage before long tasks'"
  }
}

