{
  "mcpServers": {
    "docs": {
      "command": "node",
      "args": ["./tools/mcp-docs-server.js"],
      "env": {
        "DOCS_ROOT": "./docs"
      }
    },
    "github-readonly": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_READONLY_TOKEN}"
      }
    }
  }
}
