{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex PR Swarm Finding",
  "type": "object",
  "required": ["role", "severity", "file", "title", "evidence", "recommendation"],
  "properties": {
    "role": {
      "type": "string",
      "enum": ["architect", "qa", "security", "judge"]
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "file": { "type": "string" },
    "line": { "type": ["integer", "null"], "minimum": 1 },
    "title": { "type": "string" },
    "evidence": { "type": "string" },
    "recommendation": { "type": "string" },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
